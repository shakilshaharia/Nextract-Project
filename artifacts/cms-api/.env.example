# ---------------------------------------------------------------------------
# Nextract CMS API — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# MySQL 8 (or MariaDB). `pnpm --filter @workspace/cms-api db:start` runs a
# local dev server on 3310 with this exact URL.
# allowPublicKeyRetrieval lets the driver sign in with MySQL 8's default
# password plugin over a plain localhost connection.
# Production (CloudPanel): mysql://USER:PASSWORD@127.0.0.1:3306/DBNAME?allowPublicKeyRetrieval=true
# (URL-encode special characters in the password, e.g. @ as %40.)
DATABASE_URL="mysql://nextract-ca:nextract-dev@127.0.0.1:3310/nextract?allowPublicKeyRetrieval=true"

# HTTP
PORT=4000
HOST=127.0.0.1
# Public origin of the site, used in emails, sitemap and canonical URLs.
PUBLIC_SITE_URL="http://localhost:3000"
# Where the dashboard lives; defaults to PUBLIC_SITE_URL/admin. The combined
# local development command serves it from Vite on 3001; start:cms uses 4000.
ADMIN_URL="http://localhost:3001/admin"
# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Long random string; used to salt IP hashes and sign preview links.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET="replace-this-with-at-least-32-random-characters"

# Session cookies get the Secure flag automatically when PUBLIC_SITE_URL is
# https. Set "true"/"false" only to override that.
# COOKIE_SECURE=true
SESSION_DAYS=14
# Active accounts keep their absolute lifetime above, with an idle limit too.
SESSION_IDLE_MINUTES=30
# Leave empty for direct local use. Set only after the intended ingress is
# verified to overwrite incoming X-Forwarded-For (see SECURITY-DEPLOYMENT.md).
TRUST_PROXY=
# Optional shared Redis/Valkey endpoint. Required operationally for multiple
# API processes. Use a private authenticated TLS endpoint in production.
# RATE_LIMIT_REDIS_URL=rediss://USER:PASSWORD@PRIVATE_REDIS_HOST:6379
# Enforce MFA enrollment for all CMS roles AFTER testing enrollment/recovery.
REQUIRE_ADMIN_MFA=false
# Optional 32-byte hex key from the deployment secret store. Keep a recovery
# copy separately from archives. Used only to read older encrypted backups;
# new backups and downloads are ordinary .tar.gz archives. Keep this key while
# older encrypted backups exist.
# BACKUP_ENCRYPTION_KEY=

# Media storage: "local" (files on this server) or "s3" (S3, R2, Spaces...).
STORAGE_DRIVER=local
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=100
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=            # only for S3-compatible providers
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=          # e.g. https://cdn.example.com

# Email (password resets, form notifications). You can set SMTP up from the
# admin (Settings -> Email) instead of here; admin settings take priority.
# Leave both empty in development: messages are written to ./dev-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nextract <no-reply@nextract.ca>"

# Optional reCAPTCHA v3. Without it, forms still use a honeypot, a minimum
# fill time and rate limiting.
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5

# Production only: the Next.js site runs separately; the API serves the admin.
# ADMIN_DIST="../cms-admin/dist"
